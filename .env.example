NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Optional overrides (normally derived from existing database rows) ---
# company_id stamped on new enquiries. Default: copied from the latest enquiry.
# NEXT_PUBLIC_COMPANY_ID=1
# First segment of job numbers (e.g. BONLOG/AE/26-27/031). Default: read from the latest job.
# NEXT_PUBLIC_JOB_PREFIX=BONLOG
# Enquiry number prefix (ENQ-0001). Default: ENQ
# NEXT_PUBLIC_ENQUIRY_PREFIX=ENQ
# Storage bucket for KYC files. Default: customer-documents
# NEXT_PUBLIC_DOCS_BUCKET=customer-documents
